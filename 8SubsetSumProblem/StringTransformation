bool canTransform(string s1, string s2) {
    int n = s1.size();
    int m = s2.size();

    vector<vector<bool>> dp(n + 1, vector<bool>(m + 1, false));

    dp[0][0] = true;

    for (int i = 1; i <= n; i++) {
        for (int j = 0; j <= m; j++) {

            // Delete lowercase character
            if (islower(s1[i - 1])) {
                dp[i][j] = dp[i - 1][j];
            }

            // Convert lowercase to uppercase and match
            if (j > 0 &&
                toupper(s1[i - 1]) == s2[j - 1]) {
                dp[i][j] = dp[i][j] || dp[i - 1][j - 1];
            }
        }
    }

    return dp[n][m];
}
